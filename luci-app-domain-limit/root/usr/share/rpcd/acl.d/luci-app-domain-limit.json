{
	"luci-app-domain-limit": {
		"description": "Grant access to per-device domain rate limit",
		"read": {
			"uci": [ "domain-limit" ],
			"file": {
				"/usr/sbin/domain-limit-status": [ "exec" ],
				"/usr/share/domain-limit/apps.json": [ "read" ]
			}
		},
		"write": {
			"uci": [ "domain-limit" ]
		}
	}
}
