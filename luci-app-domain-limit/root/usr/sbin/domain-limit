#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Per-device domain rate limit for fw4 / nftables.

. /lib/functions.sh

NFT_TABLE=/usr/share/nftables.d/table-pre/domain-limit.nft
NFT_JUMP=/usr/share/nftables.d/chain-pre/forward/domain-limit.nft
APPS=/usr/share/domain-limit/apps.json
RUN=/var/run/domain-limit
LOCK=/var/lock/domain-limit.lock
TICK=30
# Client lookups still fill the sets immediately through dnsmasq nftset.
REFRESH_EVERY=600
# One enforcement set per step. assign_tier and apply_tiers must list the same indexes.
MAX_TIER=3
# Traffic below this average rate does not count towards the allowance (background chatter).
ACTIVE_BPS=2500
APPLY_LOG=0

set -f

log() {
	logger -t domain-limit "$*"
}

clog() {
	[ "$APPLY_LOG" = 1 ] && log "$*"
}

sanitize() {
	printf '%s' "$1" | tr -cd 'A-Za-z0-9_'
}

strip0() {
	local v="$1"
	while [ "${v#0}" != "$v" ]; do
		v=${v#0}
	done
	[ -n "$v" ] || v=0
	printf '%s' "$v"
}

valid_ifname() {
	printf '%s' "$1" | grep -qE '^[A-Za-z][A-Za-z0-9._-]{0,14}$'
}

valid_mac() {
	printf '%s' "$1" | grep -qiE '^[0-9a-f]{2}(:[0-9a-f]{2}){5}$'
}

valid_ipv4() {
	local o1 o2 o3 o4 rest
	printf '%s' "$1" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
	o1=${1%%.*}
	rest=${1#*.}
	o2=${rest%%.*}
	rest=${rest#*.}
	o3=${rest%%.*}
	o4=${rest#*.}
	o1=$(strip0 "$o1")
	o2=$(strip0 "$o2")
	o3=$(strip0 "$o3")
	o4=$(strip0 "$o4")
	[ "$o1" -le 255 ] && [ "$o2" -le 255 ] && [ "$o3" -le 255 ] && [ "$o4" -le 255 ]
}

valid_domain() {
	local d="$1"
	[ -n "$d" ] || return 1
	[ ${#d} -le 253 ] || return 1
	printf '%s' "$d" | grep -qiE '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$'
}

# "HH:MM" -> minutes since midnight
to_min() {
	local h m
	case $1 in
		[0-9]:[0-5][0-9]|[01][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9]) ;;
		*) return 1 ;;
	esac
	h=$(strip0 "${1%%:*}")
	m=$(strip0 "${1#*:}")
	printf '%s' $((h * 60 + m))
}

day_name() {
	case $1 in
		1) echo mon ;; 2) echo tue ;; 3) echo wed ;; 4) echo thu ;;
		5) echo fri ;; 6) echo sat ;; *) echo sun ;;
	esac
}

has_day() {
	case " $1 " in
		*" $2 "*) return 0 ;;
	esac
	return 1
}

add_dom() {
	local d prefix
	d=$(printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -d ' \t\r')
	prefix=$(printf '%.2s' "$d")
	if [ "$prefix" = "*." ]; then
		d=${d#??}
	fi
	while [ "${d%.}" != "$d" ]; do
		d=${d%.}
	done
	while [ "${d#.}" != "$d" ]; do
		d=${d#.}
	done
	if ! valid_domain "$d"; then
		log "ignore domain: $1"
		return 0
	fi
	case "$DL_DOMAINS/" in
		*/"$d"/*) return 0 ;;
	esac
	DL_DOMAINS="${DL_DOMAINS}/$d"
}

add_app() {
	local id d found=0
	id=$(sanitize "$1")
	if [ -z "$id" ] || [ ! -f "$APPS" ]; then
		log "ignore app: $1"
		return 0
	fi
	for d in $(jsonfilter -i "$APPS" -e "@.$id.domains[*]" 2>/dev/null); do
		add_dom "$d"
		found=1
	done
	[ "$found" -eq 1 ] || log "unknown app: $1"
}

lan_device() {
	local d
	config_get d global lan_if
	d=${d%% *}
	if [ -z "$d" ]; then
		d=$(uci -q get network.lan.device)
		d=${d%% *}
	fi
	[ -n "$d" ] || d=br-lan
	if ! valid_ifname "$d"; then
		log "invalid LAN device, using br-lan"
		d=br-lan
	fi
	printf '%s' "$d"
}

# One device, one rule. A later rule for the same MAC or its current DHCP address is skipped.
SEEN_DEV=""

remember_device() {
	SEEN_DEV="$SEEN_DEV $1"
}

device_taken() {
	local d="$1" peer
	case " $SEEN_DEV " in
		*" $d "*) return 0 ;;
	esac
	peer=""
	if [ -r /tmp/dhcp.leases ]; then
		peer=$(awk -v d="$d" 'BEGIN { d = tolower(d) }
			{ m = tolower($2); ip = tolower($3) }
			m == d { print ip; exit }
			ip == d { print m; exit }' /tmp/dhcp.leases)
	fi
	[ -n "$peer" ] || return 1
	case " $SEEN_DEV " in
		*" $peer "*) return 0 ;;
	esac
	return 1
}

valid_mbps() {
	local n
	case $1 in
		''|*[!0-9]*) return 1 ;;
	esac
	n=$(strip0 "$1")
	[ "$n" -ge 1 ] && [ "$n" -le 10000 ]
}

valid_minutes() {
	local n
	case $1 in
		''|*[!0-9]*) return 1 ;;
	esac
	n=$(strip0 "$1")
	[ "$n" -le 1440 ]
}

# One list item: "30 4", "30 4 2" or "90 block".
step_collect() {
	local raw="$1" min act dl ul
	set -- $raw
	if [ $# -lt 2 ] || [ $# -gt 3 ] || ! valid_minutes "$1"; then
		clog "ignore step: $raw"
		return 0
	fi
	min=$(strip0 "$1")
	if [ "$2" = block ]; then
		if [ $# -ne 2 ]; then
			clog "ignore step: $raw"
			return 0
		fi
		act=block
		dl=0
		ul=0
	elif [ $# -eq 2 ]; then
		if ! valid_mbps "$2"; then
			clog "ignore step: $raw"
			return 0
		fi
		act=limit
		dl=$(strip0 "$2")
		ul=$dl
	else
		if ! valid_mbps "$2" || ! valid_mbps "$3"; then
			clog "ignore step: $raw"
			return 0
		fi
		act=limit
		dl=$(strip0 "$2")
		ul=$(strip0 "$3")
	fi
	case "
$CS_MINS
" in
		*"
$min
"*)
			clog "rule $CS_CFG: duplicate step at $min min, keeping the first"
			return 0
			;;
	esac
	CS_MINS="${CS_MINS}
$min"
	CS_LINES="${CS_LINES:+$CS_LINES
}$min $act $dl $ul"
}

append_stage() {
	local min="$1" act="$2" dl="$3" ul="$4"
	case "
$CS_MINS
" in
		*"
$min
"*)
			clog "rule $CS_CFG: duplicate step at $min min, keeping the first"
			return 0
			;;
	esac
	CS_MINS="${CS_MINS}
$min"
	CS_LINES="${CS_LINES:+$CS_LINES
}$min $act $dl $ul"
}

finish_lines() {
	local spec n
	[ -n "$CS_LINES" ] || return 1
	spec=$(printf '%s\n' "$CS_LINES" | sort -n)
	n=$(printf '%s\n' "$spec" | grep -c .)
	if [ "$n" -gt "$MAX_TIER" ]; then
		clog "rule $CS_CFG: more than $MAX_TIER steps, the later ones are ignored"
		spec=$(printf '%s\n' "$spec" | head -n "$MAX_TIER")
		n=$MAX_TIER
	fi
	STEP_SPEC=$spec
	STEP_N=$n
	STEPPED=1
	CAP_MIN=$(printf '%s\n' "$STEP_SPEC" | awk 'END { print $1 }')
	CAP_MIN=$(num_or0 "$CAP_MIN")
	return 0
}

# s1_* .. s3_* in form order. A blank minute ends the ladder.
collect_named_stages() {
	local cfg="$1" i min act dl ul
	i=1
	while [ "$i" -le "$MAX_TIER" ]; do
		config_get min "$cfg" "s${i}_min"
		[ -n "$min" ] || return 0
		if ! valid_minutes "$min"; then
			clog "skip $cfg: bad minutes on step $i"
			return 1
		fi
		min=$(strip0 "$min")
		config_get act "$cfg" "s${i}_action" limit
		if [ "$act" = block ]; then
			append_stage "$min" block 0 0
		else
			config_get dl "$cfg" "s${i}_dl"
			config_get ul "$cfg" "s${i}_ul"
			if ! valid_mbps "$dl" || ! valid_mbps "$ul"; then
				clog "skip $cfg: bad rate on step $i"
				return 1
			fi
			append_stage "$min" limit "$(strip0 "$dl")" "$(strip0 "$ul")"
		fi
		i=$((i + 1))
	done
	return 0
}

# One stage at $2 minutes using the rule's single action and rates.
apply_single() {
	local cfg="$1" quota="$2" action dl ul
	quota=$(num_or0 "$quota")
	if [ "$quota" -gt 1440 ]; then
		clog "skip $cfg: allowance out of range"
		return 1
	fi
	config_get action "$cfg" action limit
	case $action in
		block)
			STEP_SPEC="$quota block 0 0"
			;;
		limit)
			config_get dl "$cfg" dl_mbps
			config_get ul "$cfg" ul_mbps
			case $dl in
				''|*[!0-9]*) clog "skip $cfg: bad download rate"; return 1 ;;
			esac
			case $ul in
				''|*[!0-9]*) clog "skip $cfg: bad upload rate"; return 1 ;;
			esac
			dl=$(strip0 "$dl")
			ul=$(strip0 "$ul")
			if [ "$dl" -lt 1 ] || [ "$dl" -gt 10000 ]; then
				clog "skip $cfg: download rate out of range"
				return 1
			fi
			if [ "$ul" -lt 1 ] || [ "$ul" -gt 10000 ]; then
				clog "skip $cfg: upload rate out of range"
				return 1
			fi
			STEP_SPEC="$quota limit $dl $ul"
			;;
		*)
			clog "skip $cfg: unknown action $action"
			return 1
			;;
	esac
	STEP_N=1
	STEPPED=0
	CAP_MIN=$quota
	return 0
}

# Sets STEP_SPEC (sorted "minutes action dl ul"), STEP_N, STEPPED and CAP_MIN.
# policy=steps is one ladder on this rule. Without policy, a legacy step list
# still wins; otherwise one stage reproduces the single allowance and action.
collect_steps() {
	local cfg="$1" policy quota
	CS_CFG=$cfg
	CS_LINES=""
	CS_MINS=""
	STEP_SPEC=""
	STEP_N=0
	STEPPED=0
	CAP_MIN=0
	config_get policy "$cfg" policy
	case $policy in
		steps)
			collect_named_stages "$cfg" || return 1
			if [ -z "$CS_LINES" ]; then
				config_list_foreach "$cfg" step step_collect
			fi
			if finish_lines; then
				return 0
			fi
			clog "skip $cfg: steps need a first stage"
			return 1
			;;
		now)
			apply_single "$cfg" 0
			return $?
			;;
		later)
			config_get quota "$cfg" quota_min
			apply_single "$cfg" "$quota"
			return $?
			;;
	esac
	config_list_foreach "$cfg" step step_collect
	if [ -n "$CS_LINES" ]; then
		finish_lines
		return $?
	fi
	config_get quota "$cfg" quota_min
	apply_single "$cfg" "$quota"
}

prepare_rule() {
	local cfg="$1"
	local enabled device
	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" -eq 1 ] || return 1

	config_get device "$cfg" device
	device=$(printf '%s' "$device" | tr 'A-F' 'a-f' | tr -d ' \t\r')

	DL_HAVE_MAC=0
	DL_HAVE_IP=0
	DL_MAC=""
	DL_IP=""
	if valid_mac "$device"; then
		DL_HAVE_MAC=1
		DL_MAC=$device
	elif valid_ipv4 "$device"; then
		DL_HAVE_IP=1
		DL_IP=$device
	else
		log "skip $cfg: device must be a MAC or IPv4"
		return 1
	fi
	if device_taken "$device"; then
		log "skip $cfg: this device already has a rule"
		return 1
	fi
	remember_device "$device"

	DL_SID=$(sanitize "$cfg")
	[ -n "$DL_SID" ] || return 1
	collect_steps "$cfg" || return 1
	DL_DOMAINS=""
	config_list_foreach "$cfg" app add_app
	config_list_foreach "$cfg" domain add_dom
	[ -n "$DL_DOMAINS" ] || {
		log "skip $cfg: no usable domain"
		return 1
	}
	return 0
}

each_confdir() {
	local cb="$1" sec dir
	for sec in $(uci -q -X show dhcp 2>/dev/null | sed -n 's/^dhcp\.\([^=]*\)=dnsmasq$/\1/p'); do
		dir=$(uci -q get "dhcp.${sec}.confdir")
		if [ -z "$dir" ]; then
			dir="/tmp/dnsmasq.${sec}.d"
		fi
		dir=${dir%%,*}
		case $dir in
			/*) "$cb" "$dir" ;;
		esac
	done
}

_rm_dns() {
	if [ -f "$1/domain-limit.conf" ]; then
		rm -f "$1/domain-limit.conf"
		DNS_REMOVED=1
	fi
}

_put_dns() {
	mkdir -p "$1"
	cp "$DNS_TMP" "$1/domain-limit.conf" || log "failed to write $1/domain-limit.conf"
	DNS_PUTS=$((DNS_PUTS + 1))
}

apply_stop() {
	local nft=0
	rm -f "$RUN/map"
	if [ -f "$NFT_TABLE" ] || [ -f "$NFT_JUMP" ]; then
		nft=1
	fi
	rm -f "$NFT_TABLE" "$NFT_JUMP"
	DNS_REMOVED=0
	each_confdir _rm_dns
	if [ "$nft" -eq 0 ] && [ "$DNS_REMOVED" -eq 0 ]; then
		return 0
	fi
	if [ "$nft" -eq 1 ] && command -v fw4 >/dev/null 2>&1; then
		fw4 reload || log "fw4 reload failed"
	fi
	if [ "$DNS_REMOVED" -eq 1 ] && [ -x /etc/init.d/dnsmasq ]; then
		/etc/init.d/dnsmasq restart || log "dnsmasq restart failed"
	fi
	log "rules cleared"
}

write_rule() {
	local mark v4match d idx act dl ul dl_kb ul_kb dl_burst ul_burst _min
	mark=$(printf '0x%x' $((19712 + DL_N)))
	v4match=""
	[ "$DL_HAVE_MAC" -eq 1 ] && v4match=" ether saddr $DL_MAC"
	[ "$DL_HAVE_IP" -eq 1 ] && v4match=" ip saddr $DL_IP"

	cat >> "$NFT_TMP" <<EOF
set dl4_${DL_SID} {
	type ipv4_addr
	flags timeout
	timeout 2h
}

counter dlc_${DL_SID} {
	packets 0 bytes 0
}

EOF
	if [ "$DL_HAVE_MAC" -eq 1 ]; then
		cat >> "$NFT_TMP" <<EOF
set dl6_${DL_SID} {
	type ipv6_addr
	flags timeout
	timeout 2h
}

EOF
	fi

	# Not limited to ct state new: connections opened before the address entered the set must be caught too.
	printf '\tiifname "%s"%s ip daddr @dl4_%s ct mark != %s ct mark set %s comment "dl-%s-v4"\n' \
		"$DL_LAN" "$v4match" "$DL_SID" "$mark" "$mark" "$DL_SID" >> "$RULE_TMP"
	if [ "$DL_HAVE_MAC" -eq 1 ]; then
		printf '\tiifname "%s" ether saddr %s ip6 daddr @dl6_%s ct mark != %s ct mark set %s comment "dl-%s-v6"\n' \
			"$DL_LAN" "$DL_MAC" "$DL_SID" "$mark" "$mark" "$DL_SID" >> "$RULE_TMP"
	fi
	printf '\tct mark %s counter name "dlc_%s" comment "dl-%s-count"\n' \
		"$mark" "$DL_SID" "$DL_SID" >> "$RULE_TMP"
	# The mark is placed in dl_tN at run time for the active step, see tick_all.
	idx=0
	while read -r _min act dl ul; do
		[ -n "$_min" ] || continue
		if [ "$act" = block ]; then
			printf '\tct mark %s ct mark @dl_t%s counter drop comment "dl-%s-t%s-block"\n' \
				"$mark" "$idx" "$DL_SID" "$idx" >> "$RULE_TMP"
		else
			dl_kb=$((dl * 125))
			ul_kb=$((ul * 125))
			dl_burst=$dl_kb
			ul_burst=$ul_kb
			[ "$dl_burst" -lt 64 ] && dl_burst=64
			[ "$ul_burst" -lt 64 ] && ul_burst=64
			printf '\tct mark %s ct mark @dl_t%s iifname "%s" limit rate over %s kbytes/second burst %s kbytes counter drop comment "dl-%s-t%s-up"\n' \
				"$mark" "$idx" "$DL_LAN" "$ul_kb" "$ul_burst" "$DL_SID" "$idx" >> "$RULE_TMP"
			printf '\tct mark %s ct mark @dl_t%s oifname "%s" limit rate over %s kbytes/second burst %s kbytes counter drop comment "dl-%s-t%s-down"\n' \
				"$mark" "$idx" "$DL_LAN" "$dl_kb" "$dl_burst" "$DL_SID" "$idx" >> "$RULE_TMP"
		fi
		idx=$((idx + 1))
	done <<EOF
$STEP_SPEC
EOF

	for d in $(printf '%s' "$DL_DOMAINS" | tr '/' ' '); do
		if [ "$DL_HAVE_MAC" -eq 1 ]; then
			printf 'nftset=/%s/4#inet#fw4#dl4_%s,6#inet#fw4#dl6_%s\n' "$d" "$DL_SID" "$DL_SID" >> "$DNS_TMP"
		else
			printf 'nftset=/%s/4#inet#fw4#dl4_%s\n' "$d" "$DL_SID" >> "$DNS_TMP"
		fi
	done
	printf '%s %s\n' "$DL_SID" "$mark" >> "$MAP_TMP"
}

emit_one() {
	prepare_rule "$1" || return 0
	DL_N=$((DL_N + 1))
	if [ "$DL_N" -gt 64 ]; then
		log "ignoring rules after 64"
		DL_N=64
		return 0
	fi
	write_rule
}

check_nft() {
	nft -c -f - <<EOF
table inet domain_limit_check {
$(cat "$NFT_TMP")
	chain forward_test {
		jump domain_limit
	}
}
EOF
}

cleanup_tmp() {
	rm -f "$NFT_TMP" "$RULE_TMP" "$DNS_TMP" "$JUMP_TMP" "$MAP_TMP"
}

apply_start() {
	local enabled idx
	config_load domain-limit
	config_get_bool enabled global enabled 0
	if [ "$enabled" != 1 ]; then
		apply_stop
		return 0
	fi

	mkdir -p "$RUN"
	DL_LAN=$(lan_device)
	DL_N=0
	SEEN_DEV=""
	NFT_TMP=$(mktemp /tmp/domain-limit.nft.XXXXXX) || return 1
	RULE_TMP=$(mktemp /tmp/domain-limit.rules.XXXXXX) || return 1
	DNS_TMP=$(mktemp /tmp/domain-limit.dns.XXXXXX) || return 1
	JUMP_TMP=$(mktemp /tmp/domain-limit.jump.XXXXXX) || return 1
	MAP_TMP=$(mktemp /tmp/domain-limit.map.XXXXXX) || return 1
	: > "$NFT_TMP"
	idx=0
	while [ "$idx" -lt "$MAX_TIER" ]; do
		printf 'set dl_t%s {\n\ttype mark\n}\n\n' "$idx" >> "$NFT_TMP"
		idx=$((idx + 1))
	done

	APPLY_LOG=1
	config_foreach emit_one rule
	APPLY_LOG=0

	if [ "$DL_N" -eq 0 ]; then
		cleanup_tmp
		log "no active rules"
		apply_stop
		return 0
	fi

	{
		echo "chain domain_limit {"
		cat "$RULE_TMP"
		echo "}"
	} >> "$NFT_TMP"
	printf 'jump domain_limit\n' > "$JUMP_TMP"

	if ! command -v nft >/dev/null 2>&1; then
		log "nft is missing"
		cleanup_tmp
		return 1
	fi
	if ! check_nft; then
		log "generated nft failed the syntax check; previous rules left in place"
		cleanup_tmp
		return 1
	fi

	mkdir -p /usr/share/nftables.d/table-pre /usr/share/nftables.d/chain-pre/forward
	mv "$NFT_TMP" "$NFT_TABLE"
	mv "$JUMP_TMP" "$NFT_JUMP"
	mv "$MAP_TMP" "$RUN/map"
	DNS_PUTS=0
	each_confdir _put_dns
	rm -f "$RULE_TMP" "$DNS_TMP"
	[ "$DNS_PUTS" -gt 0 ] || log "no dnsmasq config directory found"

	if command -v fw4 >/dev/null 2>&1; then
		fw4 reload || log "fw4 reload failed"
		# Older builds created a fourth step set. It is unused now.
		nft delete set inet fw4 dl_t3 >/dev/null 2>&1 || true
	else
		log "fw4 not found"
		return 1
	fi
	tick_all
	if [ -x /etc/init.d/dnsmasq ]; then
		/etc/init.d/dnsmasq restart || log "dnsmasq restart failed"
		sleep 1
	fi
	refresh_sets
	log "applied $DL_N rule(s) on $DL_LAN"
}

now_vars() {
	local dow h m
	set -- $(date '+%s %Y%m%d %u %H %M')
	NOW_TS=$1
	NOW_DATE=$2
	dow=$3
	h=$(strip0 "$4")
	m=$(strip0 "$5")
	NOW_MIN=$((h * 60 + m))
	NOW_DAY=$(day_name "$dow")
	PREV_DAY=$(day_name $(( (dow + 5) % 7 + 1 )))
	# Noon of the previous day, safe against DST shifts.
	PREV_DATE=$(date -d "@$((NOW_TS - NOW_MIN * 60 - 43200))" '+%Y%m%d' 2>/dev/null)
}

# Sets WIN_KEY to the date the current window started; usage is counted per key.
in_window() {
	local cfg="$1" sched days start stop s e
	WIN_KEY="$NOW_DATE"
	config_get sched "$cfg" schedule always
	[ "$sched" = window ] || return 0
	config_get days "$cfg" weekdays
	[ -n "$days" ] || days="mon tue wed thu fri sat sun"
	config_get start "$cfg" start_time
	config_get stop "$cfg" stop_time
	s=$(to_min "$start") || return 1
	e=$(to_min "$stop") || return 1
	if [ "$s" -lt "$e" ]; then
		[ "$NOW_MIN" -ge "$s" ] && [ "$NOW_MIN" -lt "$e" ] && has_day "$days" "$NOW_DAY"
	elif [ "$s" -gt "$e" ]; then
		# Window crosses midnight; the part after midnight belongs to the previous day.
		if [ "$NOW_MIN" -ge "$s" ]; then
			has_day "$days" "$NOW_DAY"
		elif [ "$NOW_MIN" -lt "$e" ]; then
			WIN_KEY="$PREV_DATE"
			has_day "$days" "$PREV_DAY"
		else
			return 1
		fi
	else
		has_day "$days" "$NOW_DAY"
	fi
}

num_or0() {
	case $1 in
		''|*[!0-9]*) printf '0' ;;
		*) printf '%s' "$1" ;;
	esac
}

# One nft call for every named counter. Later lookups only parse this dump.
read_counters() {
	CTR_MAP=$(nft list counters table inet fw4 2>/dev/null | awk '
		$1 == "counter" {
			name = $2
			if (name == "inet")
				name = $4
			gsub(/[{}"]/, "", name)
			cur = ""
			if (name ~ /^dlc_[A-Za-z0-9_]+$/)
				cur = name
		}
		cur != "" && index($0, "bytes") > 0 {
			for (i = 1; i <= NF; i++) {
				if ($i == "bytes" && $(i + 1) ~ /^[0-9]+$/) {
					print cur, $(i + 1)
					cur = ""
					break
				}
			}
		}
	')
}

# Sets bytes from CTR_MAP. Name is the full counter name, e.g. dlc_cfg1.
counter_bytes() {
	local name="$1" n b
	bytes=0
	[ -n "$CTR_MAP" ] || return 0
	while read -r n b; do
		if [ "$n" = "$name" ]; then
			case $b in
				''|*[!0-9]*) bytes=0 ;;
				*) bytes=$b ;;
			esac
			return 0
		fi
	done <<EOF
$CTR_MAP
EOF
}

# Highest step whose minute threshold has been reached. -1 means not yet.
pick_tier() {
	local used="$1" min act dl ul idx=0
	TIER=-1
	TIER_ACTION=limit
	TIER_DL=0
	TIER_UL=0
	case $used in
		''|*[!0-9]*) used=0 ;;
	esac
	while read -r min act dl ul; do
		[ -n "$min" ] || continue
		if [ "$used" -ge $((min * 60)) ]; then
			TIER=$idx
			TIER_ACTION=$act
			TIER_DL=$dl
			TIER_UL=$ul
		fi
		idx=$((idx + 1))
	done <<EOF
$STEP_SPEC
EOF
}

assign_tier() {
	local tier="$1" mark="$2"
	case $tier in
		0) T0="${T0:+$T0, }$mark" ;;
		1) T1="${T1:+$T1, }$mark" ;;
		2) T2="${T2:+$T2, }$mark" ;;
		3) T3="${T3:+$T3, }$mark" ;;
	esac
}

apply_tiers() {
	local i marks cmd=""
	i=0
	while [ "$i" -lt "$MAX_TIER" ]; do
		case $i in
			0) marks=$T0 ;;
			1) marks=$T1 ;;
			2) marks=$T2 ;;
			3) marks=$T3 ;;
			*) marks="" ;;
		esac
		cmd="${cmd}flush set inet fw4 dl_t${i}
"
		if [ -n "$marks" ]; then
			cmd="${cmd}add element inet fw4 dl_t${i} { ${marks} }
"
		fi
		i=$((i + 1))
	done
	printf '%s' "$cmd" | nft -f - 2>/dev/null
}

tick_one() {
	local sid="$1" mark="$2" bytes key used last lastts elapsed delta win=0 enforce=0 tier=-1
	collect_steps "$sid" || return 0
	counter_bytes "dlc_$sid"

	key="" used=0 last=0 lastts=$NOW_TS
	[ -f "$RUN/usage.$sid" ] && read -r key used last lastts _rest < "$RUN/usage.$sid"
	used=$(num_or0 "$used")
	last=$(num_or0 "$last")
	lastts=$(num_or0 "$lastts")

	elapsed=$((NOW_TS - lastts))
	[ "$elapsed" -lt 0 ] && elapsed=0
	[ "$elapsed" -gt $((TICK * 3)) ] && elapsed=$((TICK * 3))
	delta=$((bytes - last))
	# fw4 reloads recreate the counter from zero
	[ "$delta" -lt 0 ] && delta=$bytes

	# The allowance belongs to one window and is cleared when the window ends.
	if in_window "$sid"; then
		win=1
		[ "$key" = "$WIN_KEY" ] || used=0
		key="$WIN_KEY"
	else
		used=0
		key="-"
	fi
	if [ "$win" -eq 1 ] && [ "$elapsed" -gt 0 ] && [ "$delta" -ge $((elapsed * ACTIVE_BPS)) ]; then
		used=$((used + elapsed))
	fi
	if [ "$win" -eq 1 ]; then
		pick_tier "$used"
		tier=$TIER
		[ "$tier" -ge 0 ] && enforce=1
	fi

	printf '%s %s %s %s %s %s\n' "$key" "$used" "$bytes" "$NOW_TS" "$win" "$enforce" > "$RUN/usage.$sid"
	[ "$enforce" -eq 1 ] && assign_tier "$tier" "$mark"
	return 0
}

tick_all() {
	local sid mark
	[ -f "$NFT_TABLE" ] && [ -f "$RUN/map" ] || return 0
	now_vars
	config_load domain-limit
	read_counters
	T0=""
	T1=""
	T2=""
	T3=""
	while read -r sid mark; do
		[ -n "$sid" ] && tick_one "$sid" "$mark"
	done < "$RUN/map"
	apply_tiers
	return 0
}

resolve_domain() {
	local domain="$1" set4="$2" set6="$3" out tok
	out=$(nslookup "$domain" 127.0.0.1 2>/dev/null) || true
	for tok in $out; do
		tok=${tok%%,}
		tok=${tok%%;}
		case $tok in
			127.0.0.1|0.0.0.0|::1|*:)
				continue
				;;
			*.*.*.*)
				valid_ipv4 "$tok" || continue
				nft add element inet fw4 "$set4" "{ $tok timeout 2h }" 2>/dev/null || true
				;;
			*:*)
				[ -n "$set6" ] || continue
				printf '%s' "$tok" | grep -qE '^[0-9A-Fa-f:]+$' || continue
				nft add element inet fw4 "$set6" "{ $tok timeout 2h }" 2>/dev/null || true
				;;
		esac
	done
}

refresh_one() {
	local d
	prepare_rule "$1" || return 0
	for d in $(printf '%s' "$DL_DOMAINS" | tr '/' ' '); do
		if [ "$DL_HAVE_MAC" -eq 1 ]; then
			resolve_domain "$d" "dl4_$DL_SID" "dl6_$DL_SID"
		else
			resolve_domain "$d" "dl4_$DL_SID" ""
		fi
	done
}

refresh_sets() {
	local enabled
	[ -f "$NFT_TABLE" ] || return 0
	config_load domain-limit
	config_get_bool enabled global enabled 0
	[ "$enabled" -eq 1 ] || return 0
	command -v nslookup >/dev/null 2>&1 || {
		log "nslookup is missing, domain addresses were not refreshed"
		return 0
	}
	config_foreach refresh_one rule
}

count_set() {
	local n
	n=$(nft list set inet fw4 "$1" 2>/dev/null | grep -c expires || true)
	[ -n "$n" ] || n=0
	printf '%s' "$n"
}

sum_packets() {
	local n
	if [ -z "$DL_CHAIN_DUMP" ]; then
		printf '0'
		return 0
	fi
	n=$(printf '%s\n' "$DL_CHAIN_DUMP" | sed -n "s/.*counter packets \\([0-9][0-9]*\\) bytes [0-9][0-9]* drop comment \"${1}\".*/\\1/p" | awk '{s+=$1} END {print s+0}')
	[ -n "$n" ] || n=0
	printf '%s' "$n"
}

status_one() {
	local cfg="$1" sid name en action quota v4 v6 up down used win enforce
	local used_sec stepped cap dl_show ul_show block_drop
	config_get name "$cfg" name
	config_get_bool en "$cfg" enabled 1
	config_get action "$cfg" action limit
	config_get quota "$cfg" quota_min
	quota=$(num_or0 "$quota")
	sid=$(sanitize "$cfg")
	v4=$(count_set "dl4_$sid")
	v6=$(count_set "dl6_$sid")
	up=$(sum_packets "dl-${sid}-t[0-9]-up")
	down=$(sum_packets "dl-${sid}-t[0-9]-down")
	block_drop=$(sum_packets "dl-${sid}-t[0-9]-block")
	down=$((down + block_drop))
	used=0 win=0 enforce=0
	[ -f "$RUN/usage.$sid" ] && read -r _key used _last _ts win enforce < "$RUN/usage.$sid"
	used_sec=$(num_or0 "$used")
	collect_steps "$cfg" || true
	stepped=$(num_or0 "$STEPPED")
	cap=$(num_or0 "$CAP_MIN")
	dl_show=0
	ul_show=0
	if [ "$(num_or0 "$enforce")" -eq 1 ]; then
		pick_tier "$used_sec"
		if [ "$TIER" -ge 0 ]; then
			action=$TIER_ACTION
			dl_show=$(num_or0 "$TIER_DL")
			ul_show=$(num_or0 "$TIER_UL")
		fi
	fi
	json_add_object
	json_add_string id "$sid"
	json_add_string name "${name:-$sid}"
	json_add_int enabled "$en"
	json_add_string action "$action"
	json_add_int quota_min "$quota"
	json_add_int stepped "$stepped"
	json_add_int cap_min "$cap"
	json_add_int dl_mbps "$dl_show"
	json_add_int ul_mbps "$ul_show"
	json_add_int used_min $((used_sec / 60))
	json_add_int window "$(num_or0 "$win")"
	json_add_int enforced "$(num_or0 "$enforce")"
	json_add_int v4 "$v4"
	json_add_int v6 "$v6"
	json_add_int up_drop "$up"
	json_add_int down_drop "$down"
	json_close_object
}

do_status() {
	local flow hw ai nftset active
	if [ ! -f /usr/share/libubox/jshn.sh ]; then
		printf '%s\n' '{"error":"jshn missing"}'
		return 1
	fi
	. /usr/share/libubox/jshn.sh
	flow=$(uci -q get firewall.@defaults[0].flow_offloading)
	hw=$(uci -q get firewall.@defaults[0].flow_offloading_hw)
	ai=$(uci -q get firewall.@defaults[0].auto_includes)
	[ -n "$flow" ] || flow=0
	[ -n "$hw" ] || hw=0
	[ -n "$ai" ] || ai=1
	if dnsmasq -v 2>&1 | grep -q nftset; then
		nftset=1
	else
		nftset=0
	fi
	if [ -f "$NFT_TABLE" ]; then
		active=1
	else
		active=0
	fi
	DL_CHAIN_DUMP=$(nft list chain inet fw4 domain_limit 2>/dev/null || true)
	json_init
	json_add_int flow_offloading "$flow"
	json_add_int flow_offloading_hw "$hw"
	json_add_int auto_includes "$ai"
	json_add_int nftset "$nftset"
	json_add_int active "$active"
	json_add_array rules
	config_load domain-limit
	config_foreach status_one rule
	json_close_array
	json_dump
	printf '\n'
}

config_stamp() {
	uci -q show domain-limit 2>/dev/null | md5sum 2>/dev/null | awk '{print $1}'
}

with_lock() {
	local rc
	mkdir -p /var/lock
	exec 9>"$LOCK"
	if command -v flock >/dev/null 2>&1; then
		flock 9
	fi
	"$@"
	rc=$?
	if command -v flock >/dev/null 2>&1; then
		flock -u 9
	fi
	return $rc
}

run_daemon() {
	local stamp now last_refresh=0
	trap 'ACTION=apply' USR1 HUP
	trap 'kill $! 2>/dev/null; exit 0' TERM INT
	ACTION=apply
	STAMP=$(config_stamp)
	while true; do
		if [ "$ACTION" != apply ]; then
			stamp=$(config_stamp)
			if [ -n "$stamp" ] && [ "$stamp" != "$STAMP" ]; then
				ACTION=apply
			fi
		fi
		if [ "$ACTION" = apply ]; then
			ACTION=tick
			with_lock apply_start || log "apply failed"
			STAMP=$(config_stamp)
			last_refresh=$(date +%s)
			continue
		fi
		with_lock tick_all || true
		now=$(date +%s)
		if [ $((now - last_refresh)) -ge "$REFRESH_EVERY" ]; then
			with_lock refresh_sets || true
			last_refresh=$now
		fi
		if [ "$ACTION" = apply ]; then
			continue
		fi
		sleep "$TICK" &
		wait $!
		kill $! 2>/dev/null
	done
}

cmd=${1:-}
case $cmd in
	status) do_status ;;
	stop) with_lock apply_stop ;;
	refresh)
		with_lock tick_all
		with_lock refresh_sets
		;;
	daemon) run_daemon ;;
	*)
		echo "usage: domain-limit daemon|stop|refresh|status" >&2
		exit 1
		;;
esac
